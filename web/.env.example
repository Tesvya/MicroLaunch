# Only needed in development (defaults to this value if omitted):
VITE_SERVER_LOCAL=http://localhost:4000/api/v1/
# Leave unset in production when the site and API are served together (the default, see DEPLOYMENT.md).
# Set ONLY if you host the frontend on a different domain than the API:
# VITE_SERVER_PRODUCTION=https://your-api.example.com/api/v1/
