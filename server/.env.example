# --- Production only (see DEPLOYMENT.md) -------------------------------------------
# Public https address of the site. On Render/Railway this is detected automatically.
# CLIENT_PRODUCTION=https://your-app.onrender.com
# Address of this API (defaults to the site address, since both are served together).
# SERVER_URL=https://your-app.onrender.com
# Only if the frontend is hosted on a DIFFERENT domain than the API (needs https):
# COOKIE_SAMESITE=none
# Rate limits per IP per 15 min (generous so a classroom on one Wi-Fi isn't blocked):
# LOGIN_FAIL_LIMIT=30        # failed logins only
# AUTH_RATE_LIMIT_MAX=100    # registrations / resend / verify
# Admin seeding on a REAL database requires a strong password (the default is refused):
# SEED_ADMIN_EMAIL=you@yourdomain.com
# SEED_ADMIN_PASSWORD=choose-a-long-unique-password
CLIENT_PRODUCTION=
