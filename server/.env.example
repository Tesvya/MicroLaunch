# --- Email (account verification) -------------------------------------------------
# Development: leave these commented out. The verification link is printed in the server
# console and shown on the "Check your email" screen so you can click it.
# Production: REQUIRED. Without SMTP no verification email can be delivered.
# Gmail: turn on 2-Step Verification, then create an "App password" (16 characters).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=MICROLAUNCH <your-address@gmail.com>
