{
  "name": "microlaunch-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --config nodemon.json src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/migrations/seed-admin.js",
    "seed:sidehustles": "node src/migrations/seed-sidehustles.js",
    "seed:all": "node src/migrations/seed-admin.js && node src/migrations/seed-sidehustles.js",
    "ml:train": "node src/modules/ml/train.js",
    "test:e2e": "node tests/e2e.mjs",
    "build": "npm run ml:train",
    "test:gateways": "node tests/gateway-mock-e2e.mjs",
    "test:hardening": "node tests/prod-hardening.mjs",
    "smoke": "node tests/deploy-smoke.mjs"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ml-random-forest": "^2.1.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.1",
    "nodemailer": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}